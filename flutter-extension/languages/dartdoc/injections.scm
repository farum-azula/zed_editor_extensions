; Generated by `python3 tests/check_queries.py --update` from DOC_LANGUAGES: the lines of a
; code block go to the language its fence names (Dart's for a fence without a name, as for
; dartdoc), a match per line and the block as their host, so that Zed parses a block's lines
; together and each block apart. Fences of other languages stay comments.

((code_block
  !language
  (code) @injection.content) @injection.host
  (#set! injection.language "Dartdoc Dart"))

((code_block
  language: (info_string) @_language
  (code) @injection.content) @injection.host
  (#any-of? @_language "dart" "Dart")
  (#set! injection.language "Dartdoc Dart"))

((code_block
  language: (info_string) @_language
  (code) @injection.content) @injection.host
  (#any-of? @_language "java" "Java")
  (#set! injection.language "Dartdoc Java"))

