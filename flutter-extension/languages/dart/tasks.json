[
  {
    "label": "dart run: $ZED_RELATIVE_FILE",
    "command": "dart \"$HOME/.zed-flutter/dart_run.dart\" \"$ZED_FILE\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "dart-main"
    ]
  },
  {
    "label": "dart run: bin/main.dart",
    "command": "dart \"$HOME/.zed-flutter/dart_run.dart\" \"$ZED_WORKTREE_ROOT/bin/main.dart\"",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
