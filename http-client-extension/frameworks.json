          "path_params": ["dollar", "colon"],
          "query": ["params: {keys}"],
          "headers": ["headers: {keys}"],
          "body": [".{method}{generic}(\"{path}\", {keys}", ".{method}{generic}(\"{path}\", {var}", "data: {keys}"],
          "examples": [
