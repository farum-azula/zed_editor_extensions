          "name": "HttpClient",
          "docs": "https://learn.microsoft.com/dotnet/fundamentals/networking/http/httpclient",
          "imports": ["HttpClient", "System.Net.Http"],
          "routes": [".{method}Async(\"{route}\"", ".{method}FromJsonAsync{generic}(\"{route}\"", ".{method}AsJsonAsync(\"{route}\"", "new HttpRequestMessage(HttpMethod.{method}, \"{path}\"", ".{method}Async({ref})", ".{method}Async({ref},"],
          "path_params": ["braces"],
          "headers": ["DefaultRequestHeaders.Add(\"{name}\""],
          "examples": [
            { "code": "using System.Net.Http;\nvar r = await client.GetFromJsonAsync<Todo>(\"https://jsonplaceholder.typicode.com/todos/1\");", "expect": ["GET https://jsonplaceholder.typicode.com/todos/1"] },
            {
              "code": "using System.Net.Http;\nvar url = Environment.GetEnvironmentVariable(\"API_URL\");\nawait client.GetAsync(url);",
              "expect": ["GET {{API_URL}}"]
            }
          ]
        }
      }
    },
    "*": {
      "name": "Any language",
      "zed": [],
      "extensions": ["*"],
      "frameworks": {
        "url-literal": {
          "name": "Absolute URL literals (code action only, no lens)",
          "routes": [
            { "pattern": "\"https://{path}\"", "url": "https://{path}", "weak": true },
            { "pattern": "\"http://{path}\"", "url": "http://{path}", "weak": true }
          ],
          "path_params": ["dollar", "braces"],
          "examples": [
            { "code": "const BASE = \"https://api.example.com/v2\";", "expect": ["GET https://api.example.com/v2"] }
          ]
        }
      }
    }
  }
