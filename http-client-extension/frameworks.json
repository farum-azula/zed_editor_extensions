{
  "$schema": "./frameworks.schema.json",
  "types": {
    "int": ["int", "integer", "long", "short", "byte", "number", "num", "bigint", "biginteger", "i8", "i16", "i32", "i64", "i128", "u8", "u16", "u32", "u64", "u128", "usize", "isize", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64"],
    "float": ["float", "double", "decimal", "bigdecimal", "f32", "f64", "float32", "float64", "single"],
    "bool": ["bool", "boolean"],
    "string": ["string", "str", "char", "character", "uuid", "guid", "datetime", "date", "localdate", "localdatetime", "offsetdatetime", "zoneddatetime", "instant", "time", "timestamp", "url", "uri", "email", "emailstr"],
    "list": ["list", "vec", "set", "hashset", "array", "iterable", "collection", "sequence", "seq", "slice", "flux", "ienumerable", "icollection"],
    "object": ["map", "hashmap", "dict", "record", "object", "any", "dynamic", "jsonnode", "jsonobject", "value"],
    "wrappers": ["Optional", "Option", "Mono", "Future", "Promise", "ResponseEntity", "Json", "Query", "Form", "Body", "Valid", "Nullable", "Annotated", "Task", "ActionResult", "web::Json", "web::Query", "web::Form"]
  },
  "auth": ["Authorization", "Bearer", "\"authorization\""],
  "urls": {
    "assignments": ["{var} = {expr}", "{var}: {expr}", "{var} => {expr}"],
    "literals": ["\"{path}\""],
    "env": ["env(\"{name}\")", "env[\"{name}\"]", "ENV[\"{name}\"]", "env.get(\"{name}\")", "environ[\"{name}\"]", "environ.get(\"{name}\")", "process.env.{name}", "GetEnvironmentVariable(\"{name}\")"]
  },
  "languages": {
    "java": {
      "name": "Java",
      "zed": ["Java"],
      "extensions": ["java"],
      "decorators": ["@"],
      "class_keywords": ["class", "interface", "record", "enum"],
      "definitions": ["^public {type} {handler}(", "^protected {type} {handler}(", "^private {type} {handler}(", "^public static {type} {handler}("],
      "variables": ["{type} {var} =", "{type} {var};", "{type} {var},", "{type} {var})"],
      "models": {
        "declarations": ["record {type}", "class {type}", "interface {type}"],
        "block": "braces",
        "modifiers": ["private", "public", "protected", "final", "static", "transient", "volatile"],
        "fields": ["{type} {name}"]
      },
      "frameworks": {
        "spring": {
          "name": "Spring Web (MVC / WebFlux / OpenFeign)",
          "docs": "https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-requestmapping.html",
          "imports": ["org.springframework"],
          "prefix": ["@RequestMapping(\"{path}\"", "@RequestMapping(value = \"{path}\"", "@RequestMapping(path = \"{path}\""],
          "routes": [
            "@{method}Mapping(\"{path}\"",
            "@{method}Mapping(value = \"{path}\"",
            "@{method}Mapping(path = \"{path}\"",
            "@{method}Mapping({{\"{path}\"",
            "@{method}Mapping",
            "@RequestMapping(...\"{path}\"...RequestMethod.{method}",
            { "pattern": "@RequestMapping(\"{path}\"", "method": "GET" }
          ],
          "path_params": ["braces"],
          "query": [
            "@RequestParam(\"{name}\"...) {type} {_}",
            "@RequestParam(...value = \"{name}\"...) {type} {_}",
            "@RequestParam(...name = \"{name}\"...) {type} {_}",
            "@RequestParam(...) {type} {name}",
            "@RequestParam {type} {name}"
          ],
          "headers": ["@RequestHeader(\"{name}\"", "@RequestHeader(...value = \"{name}\"", "@RequestHeader(...name = \"{name}\"", "@RequestHeader {type} {name}"],
          "body": ["@RequestBody @{_} {type} {_}", "@RequestBody {type} {_}"],
          "auth": ["@PreAuthorize", "@Secured", "@RolesAllowed", "@AuthenticationPrincipal"],
          "examples": [
            {
              "code": "import org.springframework.web.bind.annotation.*;\n@RestController\n@RequestMapping(\"/api/users\")\npublic class C {\n  @GetMapping(\"/{id}\")\n  User get(@PathVariable long id) {}\n  @PostMapping\n  User create() {}\n  @RequestMapping(value = \"/{id}/avatar\", method = RequestMethod.DELETE)\n  void d() {}\n}\nrecord CreateUser(String name) {}",
              "expect": ["GET {{baseUrl}}/api/users/{{id}}", "POST {{baseUrl}}/api/users", "DELETE {{baseUrl}}/api/users/{{id}}/avatar"]
            }
          ]
        },
        "jax-rs": {
          "name": "JAX-RS (Quarkus, Jakarta EE, Helidon, Dropwizard)",
          "docs": "https://quarkus.io/guides/rest",
          "imports": ["jakarta.ws.rs", "javax.ws.rs"],
          "prefix": ["@Path(\"{path}\")"],
          "routes": ["@{method} @Path(\"{path}\")", "@Path(\"{path}\") @{method}", "@{method}"],
          "path_params": ["braces"],
          "query": ["@QueryParam(\"{name}\") {type} {_}", "@QueryParam(\"{name}\")"],
          "headers": ["@HeaderParam(\"{name}\")"],
          "body": ["@Valid {type} {_}"],
          "auth": ["@RolesAllowed", "@Authenticated"],
          "examples": [
            {
              "code": "import jakarta.ws.rs.*;\n@Path(\"/greetings\")\npublic class R {\n  @GET\n  public String all() {}\n  @POST\n  @Path(\"/{id}\")\n  public String one() {}\n}",
              "expect": ["GET {{baseUrl}}/greetings", "POST {{baseUrl}}/greetings/{{id}}"]
            }
          ]
        },
        "micronaut": {
          "name": "Micronaut HTTP",
          "docs": "https://docs.micronaut.io/latest/guide/#routing",
          "imports": ["io.micronaut.http"],
          "prefix": ["@Controller(\"{path}\")"],
          "routes": ["@{method}(\"{path}\"", "@{method}(uri = \"{path}\"", "@{method}(value = \"{path}\"", "@{method}"],
          "path_params": ["braces"],
          "query": ["@QueryValue(\"{name}\") {type} {_}", "@QueryValue {type} {name}"],
          "headers": ["@Header(\"{name}\")"],
          "body": ["@Body {type} {_}"],
          "auth": ["@Secured"],
          "examples": [
            {
              "code": "import io.micronaut.http.annotation.*;\n@Controller(\"/books\")\npublic class B {\n  @Get(\"/{isbn}\")\n  Book find() {}\n  @Post\n  Book save() {}\n}",
              "expect": ["GET {{baseUrl}}/books/{{isbn}}", "POST {{baseUrl}}/books"]
            }
          ]
        },
        "retrofit": {
          "name": "Retrofit",
          "docs": "https://square.github.io/retrofit/",
          "imports": ["retrofit2"],
          "routes": ["@{method}(\"{path}\")", "@HTTP(method = \"{method}\", path = \"{path}\""],
          "path_params": ["braces"],
          "query": ["@Query(\"{name}\") {type} {_}"],
          "headers": ["@Header(\"{name}\")"],
          "body": ["@Body {type} {_}"],
          "examples": [
            {
              "code": "import retrofit2.http.*;\ninterface GitHub {\n  @GET(\"users/{user}/repos\")\n  Call<List<Repo>> repos();\n}",
              "expect": ["GET {{baseUrl}}/users/{{user}}/repos"]
            }
          ]
        },
        "feign": {
          "name": "OpenFeign (native annotations)",
          "docs": "https://github.com/OpenFeign/feign",
          "imports": ["import feign."],
          "routes": ["@RequestLine(\"{method} {path}\")"],
          "path_params": ["braces"],
          "query": ["@Param(\"{name}\")"],
          "headers": ["@Headers(\"{name}:"],
          "examples": [
            { "code": "import feign.RequestLine;\ninterface Api {\n  @RequestLine(\"POST /repos/{owner}\")\n  void create();\n}", "expect": ["POST {{baseUrl}}/repos/{{owner}}"] }
          ]
        }
      }
    },
    "kotlin": {
      "name": "Kotlin",
      "zed": ["Kotlin"],
      "extensions": ["kt", "kts"],
      "decorators": ["@"],
      "class_keywords": ["class", "interface", "object"],
      "definitions": ["fun {handler}(", "fun {_}.{handler}("],
      "variables": ["val {var}: {type}", "var {var}: {type}", "{var}: {type}"],
      "models": {
        "declarations": ["data class {type}", "class {type}"],
        "block": "braces",
        "modifiers": ["val", "var", "private", "public", "internal", "override", "open", "lateinit"],
        "fields": ["{name}: {type}"]
      },
      "frameworks": {
        "spring": {
          "name": "Spring Web (Kotlin)",
          "docs": "https://docs.spring.io/spring-framework/reference/languages/kotlin.html",
          "imports": ["org.springframework"],
          "prefix": ["@RequestMapping(\"{path}\"", "@RequestMapping(value = [\"{path}\"", "@RequestMapping(path = [\"{path}\""],
          "routes": [
            "@{method}Mapping(\"{path}\"",
            "@{method}Mapping(value = [\"{path}\"",
            "@{method}Mapping(path = [\"{path}\"",
            "@{method}Mapping",
            { "pattern": "@RequestMapping(\"{path}\"", "method": "GET" }
          ],
          "path_params": ["braces"],
          "query": ["@RequestParam(\"{name}\"...) {_}: {type}", "@RequestParam(...) {name}: {type}", "@RequestParam {name}: {type}"],
          "headers": ["@RequestHeader(\"{name}\"", "@RequestHeader {name}: {type}"],
          "body": ["@RequestBody @{_} {_}: {type}", "@RequestBody {_}: {type}"],
          "auth": ["@PreAuthorize", "@Secured"],
          "examples": [
            {
              "code": "import org.springframework.web.bind.annotation.*\n@RestController\n@RequestMapping(\"/api/orders\")\nclass OrderController {\n  @GetMapping(\"/{id}\")\n  fun get(@PathVariable id: Long) = 1\n}",
              "expect": ["GET {{baseUrl}}/api/orders/{{id}}"]
            }
          ]
        },
        "ktor-server": {
          "name": "Ktor server",
          "docs": "https://ktor.io/docs/server-routing.html",
          "imports": ["io.ktor.server"],
          "routes": ["^{method}(\"{path}\")"],
          "path_params": ["braces"],
          "query": ["queryParameters[\"{name}\"]"],
          "headers": ["request.headers[\"{name}\"]", "request.header(\"{name}\")"],
          "body": ["call.receive<{type}>()"],
          "auth": ["authenticate("],
          "examples": [
            { "code": "import io.ktor.server.routing.*\nfun Route.users() {\n    get(\"/users/{id}\") {\n    }\n    post(\"/users\") {\n    }\n}", "expect": ["GET {{baseUrl}}/users/{{id}}", "POST {{baseUrl}}/users"] }
          ]
        },
        "ktor-client": {
          "name": "Ktor client",
          "docs": "https://ktor.io/docs/client-requests.html",
          "imports": ["io.ktor.client"],
          "routes": [".{method}(\"{route}\"", ".{method}({ref})", ".{method}({ref},"],
          "path_params": ["dollar"],
          "body": ["setBody({var})"],
          "examples": [
            { "code": "import io.ktor.client.*\nsuspend fun f() = client.get(\"https://ktor.io/docs/$page\")", "expect": ["GET https://ktor.io/docs/{{page}}"] },
            {
              "code": "import io.ktor.client.request.*\nval endpoint = System.getenv(\"API_URL\")\nsuspend fun load(client: HttpClient) = client.get(endpoint)",
              "expect": ["GET {{API_URL}}"]
            }
          ]
        },
        "retrofit": {
          "name": "Retrofit (Kotlin)",
          "docs": "https://square.github.io/retrofit/",
          "imports": ["retrofit2"],
          "routes": ["@{method}(\"{path}\")"],
          "path_params": ["braces"],
          "query": ["@Query(\"{name}\") {_}: {type}"],
          "headers": ["@Header(\"{name}\")"],
          "body": ["@Body {_}: {type}"],
          "examples": [
            { "code": "import retrofit2.http.*\ninterface Api {\n  @POST(\"/users\")\n  suspend fun create(@Body user: User): User\n}", "expect": ["POST {{baseUrl}}/users"] }
          ]
        },
        "jax-rs": {
          "name": "JAX-RS (Quarkus Kotlin)",
          "docs": "https://quarkus.io/guides/kotlin",
          "imports": ["jakarta.ws.rs", "javax.ws.rs"],
          "prefix": ["@Path(\"{path}\")"],
          "routes": ["@{method} @Path(\"{path}\")", "@Path(\"{path}\") @{method}", "@{method}"],
          "path_params": ["braces"],
          "query": ["@QueryParam(\"{name}\") {_}: {type}"],
          "headers": ["@HeaderParam(\"{name}\")"],
          "examples": [
            { "code": "import jakarta.ws.rs.*\n@Path(\"/hello\")\nclass Hello {\n  @GET\n  fun hello() = \"hi\"\n}", "expect": ["GET {{baseUrl}}/hello"] }
          ]
        }
      }
    },
    "dart": {
      "name": "Dart / Flutter",
      "zed": ["Dart"],
      "extensions": ["dart"],
      "decorators": ["@"],
      "class_keywords": ["class", "mixin", "extension"],
      "definitions": ["^{type} {handler}(", "^static {type} {handler}("],
      "variables": ["{type} {var}", "final {type} {var}", "{var} = {type}("],
      "models": {
        "declarations": ["class {type}"],
        "block": "braces",
        "modifiers": ["final", "late", "required", "const"],
        "fields": ["{type} {name}"]
      },
      "frameworks": {
        "dio": {
          "name": "Dio",
          "docs": "https://pub.dev/packages/dio",
          "imports": ["package:dio/"],
          "routes": [".{method}{generic}(\"{route}\"", ".{method}{generic}({ref})", ".{method}{generic}({ref},"],
          "path_params": ["dollar", "braces"],
          "query": ["queryParameters: {keys}"],
          "headers": ["headers: {keys}"],
          "body": ["data: {keys}", "data: {var}.toJson()", "data: jsonEncode({keys})", "data: FormData.fromMap({keys})"],
          "examples": [
            {
              "code": "import 'package:dio/dio.dart';\nfinal a = _dio.post<Map<String, dynamic>>('/auth/login', data: {});\nfinal b = dio.get('/users/$id');",
              "expect": ["POST {{baseUrl}}/auth/login", "GET {{baseUrl}}/users/{{id}}"]
            },
            {
              "code": "import 'package:dio/dio.dart';\nfinal baseUrl = '$host/v2';\nFuture<Response> items(Dio dio) => dio.get(baseUrl);",
              "expect": ["GET {{host}}/v2"]
            }
          ]
        },
        "http": {
          "name": "package:http",
          "docs": "https://pub.dev/packages/http",
          "imports": ["package:http/"],
          "routes": [
            ".{method}(Uri.parse(\"{path}\")",
            { "pattern": ".{method}(Uri.https(\"{host}\", \"{path}\"", "url": "https://{host}{path}" },
            { "pattern": ".{method}(Uri.http(\"{host}\", \"{path}\"", "url": "http://{host}{path}" },
            ".{method}({ref})",
            ".{method}({ref},"
          ],
          "path_params": ["dollar"],
          "query": ["Uri.https(\"{host}\", \"{path}\", {keys}"],
          "headers": ["headers: {keys}"],
          "body": ["body: jsonEncode({keys})", "body: jsonEncode({var}.toJson())", "body: {var}.toJson()", "body: {keys}"],
          "examples": [
            {
              "code": "import 'package:http/http.dart' as http;\nf() => http.put(Uri.parse('$baseUrl/items/${item.id}'));\ng() => http.delete(Uri.https('api.example.com', '/v1/tasks/$id'));",
              "expect": ["PUT {{baseUrl}}/items/{{id}}", "DELETE https://api.example.com/v1/tasks/{{id}}"]
            },
            {
              "code": "import 'package:http/http.dart' as http;\nclass Ai {\n  late final Uri _endpoint;\n  void install() => _endpoint = Uri.parse(dotenv.get('GROQ_URL'));\n  Future<Response> send(String prompt) => http.post(\n        _endpoint,\n        headers: {'Content-Type': 'application/json'},\n      );\n}",
              "expect": ["POST {{GROQ_URL}}"]
            }
          ]
        },
        "retrofit": {
          "name": "retrofit.dart",
          "docs": "https://pub.dev/packages/retrofit",
          "imports": ["package:retrofit/"],
          "routes": ["@{method}(\"{path}\")"],
          "path_params": ["braces"],
          "query": ["@Query(\"{name}\") {type} {_}", "@Queries() {type} {_}"],
          "headers": ["@Header(\"{name}\")"],
          "body": ["@Body() {type} {_}"],
          "examples": [
            {
              "code": "import 'package:retrofit/retrofit.dart';\nabstract class TaskApi {\n  @GET('/tasks/{id}')\n  Future<Task> getTask(@Path('id') String id);\n  @POST('/tasks')\n  Future<Task> create(@Body() Task task);\n}",
              "expect": ["GET {{baseUrl}}/tasks/{{id}}", "POST {{baseUrl}}/tasks"]
            }
          ]
        },
        "chopper": {
          "name": "Chopper",
          "docs": "https://pub.dev/packages/chopper",
          "imports": ["package:chopper/"],
          "prefix": ["@ChopperApi(baseUrl: \"{path}\")"],
          "routes": ["@{method}(path: \"{path}\")", "@{method}()"],
          "path_params": ["braces"],
          "query": ["@Query(\"{name}\") {type} {_}", "@Query() {type} {name}"],
          "headers": ["@Header(\"{name}\")"],
          "body": ["@Body() {type} {_}"],
          "examples": [
            {
              "code": "import 'package:chopper/chopper.dart';\n@ChopperApi(baseUrl: '/todos')\nabstract class TodosService extends ChopperService {\n  @Get(path: '/{id}')\n  Future<Response> getTodo(@Path() String id);\n  @Post()\n  Future<Response> create(@Body() Todo todo);\n}",
              "expect": ["GET {{baseUrl}}/todos/{{id}}", "POST {{baseUrl}}/todos"]
            }
          ]
        },
        "shelf_router": {
          "name": "shelf_router",
          "docs": "https://pub.dev/packages/shelf_router",
          "imports": ["package:shelf_router/"],
          "routes": [".{method}(\"{route}\"", "@Route.{method}(\"{route}\")"],
          "path_params": ["angle"],
          "query": ["url.queryParameters[\"{name}\"]"],
          "headers": ["headers[\"{name}\"]"],
          "examples": [
            { "code": "import 'package:shelf_router/shelf_router.dart';\nvoid main() {\n  app.get('/hello/<name>', h);\n}", "expect": ["GET {{baseUrl}}/hello/{{name}}"] }
          ]
        }
      }
    },
    "typescript": {
      "name": "TypeScript / JavaScript",
      "zed": ["TypeScript", "TSX", "JavaScript"],
      "extensions": ["ts", "tsx", "js", "jsx", "mjs", "cjs", "mts", "cts"],
      "decorators": ["@"],
      "class_keywords": ["class"],
      "definitions": ["function {handler}(", "const {handler} = (", "const {handler} = async (", "let {handler} = (", "^async {handler}(", "^{handler}(...) {{"],
      "handler_refs": [", {handler})", ", {handler});"],
      "variables": ["{var}: {type}", "const {var} = new {type}("],
      "models": {
        "declarations": ["interface {type}", "type {type} =", "class {type}"],
