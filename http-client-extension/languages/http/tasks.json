[
  {
    "label": "HTTP: ${ZED_CUSTOM_method:GET} $ZED_CUSTOM_url",
    "command": "\"$(command -v zed-http || echo \"$HOME/.zed-http/bin/zed-http\")\"",
    "args": ["run", "\"$ZED_FILE\"", "--line", "$ZED_ROW"],
    "tags": ["http-request"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "HTTP: $ZED_CUSTOM_name",
    "command": "\"$(command -v zed-http || echo \"$HOME/.zed-http/bin/zed-http\")\"",
    "args": ["run", "\"$ZED_FILE\"", "--line", "$ZED_ROW"],
    "tags": ["http-request-named"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "HTTP: run all requests in $ZED_FILENAME",
    "command": "\"$(command -v zed-http || echo \"$HOME/.zed-http/bin/zed-http\")\"",
    "args": ["run", "\"$ZED_FILE\"", "--all"]
  },
  {
    "label": "http: new endpoint",
    "command": "\"$(command -v zed-http || echo \"$HOME/.zed-http/bin/zed-http\")\"",
    "args": ["new", "\"$ZED_WORKTREE_ROOT\""],
    "use_new_terminal": true,
    "reveal": "always",
    "hide": "on_success"
  }
]
